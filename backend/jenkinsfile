pipeline {

    agent any

    environment {

        IMAGE = "kapildhokane/healthcare-api"

        TAG = "${BUILD_NUMBER}"

    }

    stages {

        stage('Clone') {

            steps {

                checkout scm

            }

        }

        stage('Build Docker Image') {

            steps {

                dir('backend') {

                    sh '''
                    docker build -t $IMAGE:$TAG .
                    '''

                }

            }

        }

        stage('Push Image') {

            steps {

                withDockerRegistry(

                credentialsId: 'dockerhub-creds',

                url: ''

                ) {

                    sh '''
                    docker push $IMAGE:$TAG
                    docker tag $IMAGE:$TAG $IMAGE:latest
                    docker push $IMAGE:latest
                    '''

                }

            }

        }

        stage('Deploy') {

            steps {

                sshagent(['production-server']) {

                    sh '''

ssh ubuntu@YOUR_SERVER_IP << EOF

docker pull $IMAGE:latest

docker stop healthcare || true

docker rm healthcare || true

docker run -d \\
--name healthcare \\
-p 5000:5000 \\
$IMAGE:latest

EOF

'''

                }

            }

        }

    }

}
